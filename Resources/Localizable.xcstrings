            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Удаляются записи, не использовавшиеся %lld дня. Следующая сборка или установка, которой понадобится одна из них, скачает или пересоберёт её."
                }
              },
              "many": {
                "stringUnit": {
