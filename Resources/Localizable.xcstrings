    },
    "Entries unused for %lld days are removed. The next build or install that needs one of them fetches or rebuilds it.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Entries unused for %lld day are removed. The next build or install that needs one of them fetches or rebuilds it."
                }
              },
