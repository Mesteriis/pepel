                  "state": "translated",
                  "value": "Ждать штатного завершения %lld с"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ждать штатного завершения %lld с"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ждать штатного завершения %lld с"
                }
              }
            }
          }
        }
      }
    },
    "Waiting for approval in System Settings › General › Login Items.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидается разрешение в Системные настройки › Основные › Объекты входа."
          }
        }
      }
    },
    "Waiting for you: %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ждёт вас: %@"
          }
        }
      }
    },
    "Wake": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разбудить"
          }
        }
      }
    },
    "Walks your home folder, leaving out Library, caches and agents' folders. Takes a few minutes; nothing is removed.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обходит домашнюю папку, пропуская Library, кэши и папки агентов. Занимает несколько минут; ничего не удаляется."
          }
        }
      }
    },
    "Warn when PEPEL itself holds more than %lld MB": {
      "localizations": {
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Предупреждать, если PEPEL сам занимает больше %lld МБ"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Предупреждать, если PEPEL сам занимает больше %lld МБ"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Предупреждать, если PEPEL сам занимает больше %lld МБ"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Предупреждать, если PEPEL сам занимает больше %lld МБ"
                }
              }
            }
          }
        }
      }
    },
    "Warn when PEPEL itself holds more than 0 MB (off)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предупреждать, если PEPEL сам занимает больше 0 МБ (выкл.)"
          }
        }
      }
    },
    "Warn when disk space falls below %lld GB": {
      "localizations": {
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Предупреждать, если свободного места меньше %lld ГБ"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Предупреждать, если свободного места меньше %lld ГБ"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Предупреждать, если свободного места меньше %lld ГБ"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Предупреждать, если свободного места меньше %lld ГБ"
                }
              }
            }
          }
        }
      }
    },
    "Warn when memory is forecast to run short within %lld min (0 = never)": {
      "localizations": {
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Предупреждать, если по прогнозу память закончится в течение %lld мин (0 — никогда)"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Предупреждать, если по прогнозу память закончится в течение %lld мин (0 — никогда)"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Предупреждать, если по прогнозу память закончится в течение %lld мин (0 — никогда)"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Предупреждать, если по прогнозу память закончится в течение %lld мин (0 — никогда)"
                }
              }
            }
          }
        }
      }
    },
    "Web content shown inside an application. PEPEL cannot tell which one.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Веб-содержимое, показанное внутри приложения. PEPEL не может определить, какого."
          }
        }
      }
    },
    "Wednesday": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Среда"
          }
        }
      }
    },
    "What PEPEL established": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что установил PEPEL"
          }
        }
      }
    },
    "What PEPEL gave back in memory and disk, what it removed, and what waits for your decision.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько памяти и места на диске вернул PEPEL, что удалил и что ждёт вашего решения."
          }
        }
      }
    },
    "What an agent's server started is only ended when you ask: PEPEL infers that it is left behind, it cannot know.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "То, что запустил сервер агента, завершается только по запросу: PEPEL лишь предполагает, что это брошено, знать наверняка он не может."
          }
        }
      }
    },
    "What happens to a session that has gone quiet. A working session is never touched.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что происходит с затихшей сессией. Работающая сессия никогда не трогается."
          }
        }
      }
    },
    "What happens to them": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что с ними происходит"
          }
        }
      }
    },
    "What removed applications left behind is only moved to the Trash when you ask.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставшееся от удалённых приложений отправляется в Корзину только по запросу."
          }
        }
      }
    },
    "When a project is idle": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда проект простаивает"
          }
        }
      }
    },
    "Where the memory went": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Куда ушла память"
          }
        }
      }
    },
    "While a session runs in a project, that project's build output is not cleaned automatically, and cleaning it by hand asks for confirmation.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока в проекте идёт сессия, результаты его сборки не очищаются автоматически, а очистка вручную требует подтверждения."
          }
        }
      }
    },
    "Whole disk": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Весь диск"
          }
        }
      }
    },
    "Widgets reload their content.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Виджеты перезагрузят содержимое."
          }
        }
      }
    },
    "Window": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окно"
          }
        }
      }
    },
    "Wired": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закреплённая память"
          }
        }
      }
    },
    "With a size limit, the least recently used entries of a cache that is too large go first; anything used within the last day always stays. Gradle cleans its own caches and is left to it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При ограничении размера из слишком большого кэша первыми уходят давно не использовавшиеся записи; всё, что использовалось за последние сутки, всегда остаётся. Gradle очищает свои кэши сам, и ему это оставлено."
          }
        }
      }
    },
    "Without Full Disk Access some folders cannot be read; they are reported as unreadable and counted as a lower bound. Processes of other users are not inspected. Notifications and the login item ask for approval the first time they are used.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
