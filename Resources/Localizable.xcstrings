          }
        }
      }
    },
    "The VM may use up to %@. Containers use %@ now, %@ at most in the days PEPEL has watched.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The VM may use up to %1$@. Containers use %2$@ now, %3$@ at most in the days PEPEL has watched."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ВМ может использовать до %1$@. Контейнеры сейчас используют %2$@, максимум за дни наблюдения PEPEL — %3$@."
          }
        }
      }
    },
    "The VM may use up to %@. Containers use %@ now.": {
      "localizations": {
        "en": {
