    "Only items classified safe are cleaned automatically.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически очищается только то, что отнесено к безопасному."
          }
        }
      }
    },
    "Only untagged layers are pruned; the figure Docker reports also includes unused tagged images.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляются только слои без тегов; цифра, которую показывает Docker, включает и неиспользуемые образы с тегами."
          }
        }
      }
    },
    "Only verified abandoned build and test processes are terminated automatically.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически завершаются только проверенные брошенные процессы сборки и тестов."
          }
        }
      }
    },
    "Only when at least %lld GB would come back": {
      "localizations": {
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Только если освободится не меньше %lld ГБ"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Только если освободится не меньше %lld ГБ"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Только если освободится не меньше %lld ГБ"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Только если освободится не меньше %lld ГБ"
                }
              }
            }
          }
        }
      }
    },
    "Only you can change the VM's memory limit.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменить предел памяти ВМ можете только вы."
          }
        }
      }
    },
    "Only you can change this permission.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменить это разрешение можете только вы."
          }
        }
      }
    },
    "Only you can have a simulator shut down.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключить симулятор можете только вы."
          }
        }
      }
    },
    "Only you can have an application quit.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыть приложение можете только вы."
          }
        }
      }
    },
    "Only you can have this moved to the Trash.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправить это в Корзину можете только вы."
          }
        }
      }
    },
    "Open": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть"
          }
        }
      }
    },
    "Open Free memory with Control-Option-Command-M from anywhere": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывать «Освободить память» сочетанием Control-Option-Command-M откуда угодно"
          }
        }
      }
    },
    "Open all": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть все"
          }
        }
      }
    },
    "Open but unused": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыты, но не используются"
          }
        }
      }
    },
    "Open folder": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть папку"
          }
        }
      }
    },
    "Open, but not brought to the front for %lld hours and idle in the background. Asked to quit normally; one that does not quit is left running.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Open, but not brought to the front for %lld hour and idle in the background. Asked to quit normally; one that does not quit is left running."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Open, but not brought to the front for %lld hours and idle in the background. Asked to quit normally; one that does not quit is left running."
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Открыто, но не выводилось на передний план %lld часа и простаивает в фоне. Получает обычный запрос на закрытие; если не закроется, остаётся работать."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Открыто, но не выводилось на передний план %lld часов и простаивает в фоне. Получает обычный запрос на закрытие; если не закроется, остаётся работать."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Открыто, но не выводилось на передний план %lld час и простаивает в фоне. Получает обычный запрос на закрытие; если не закроется, остаётся работать."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Открыто, но не выводилось на передний план %lld часов и простаивает в фоне. Получает обычный запрос на закрытие; если не закроется, остаётся работать."
                }
              }
            }
          }
        }
      }
    },
    "OpenCode configuration": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфигурация OpenCode"
          }
        }
      }
    },
    "OpenCode state": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Состояние OpenCode"
          }
        }
      }
    },
    "Opens the cleanup review. Nothing is removed until you confirm.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает проверку очистки. Ничего не удаляется, пока вы не подтвердите."
          }
        }
      }
    },
    "Opens this folder.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает эту папку."
          }
        }
      }
    },
    "Orphaned but still working; it may be a long job started with nohup.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остался без родителя, но ещё работает; возможно, это долгая задача, запущенная через nohup."
          }
        }
      }
    },
    "Other": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другое"
          }
        }
      }
    },
    "Other large places": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другие крупные места"
          }
        }
      }
    },
    "Outside the night window (%lld:00–%lld:00) and not overdue.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Outside the night window (%1$lld:00–%2$lld:00) and not overdue."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вне ночного окна (%lld:00–%lld:00), и срок ещё не прошёл."
          }
        }
      }
    },
    "Over the last %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За последние %@"
          }
        }
      }
    },
    "Overview": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обзор"
          }
        }
      }
    },
    "Owned by a running agent session.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принадлежит работающей сессии агента."
          }
        }
      }
    },
    "Ownership could not be verified.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить владельца."
          }
        }
      }
    },
    "PEPEL": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL"
          }
        }
      }
    },
    "PEPEL began tracking disk writes of %@ (PID %d); the quiet clock starts here": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "PEPEL began tracking disk writes of %1$@ (PID %2$d); the quiet clock starts here"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL начал отслеживать запись на диск у %@ (PID %d); отсчёт тишины начинается отсюда"
          }
        }
      }
    },
    "PEPEL can clean": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL может очистить"
          }
        }
      }
    },
    "PEPEL can clean %@ of this.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL может очистить %@ из этого."
          }
        }
      }
    },
    "PEPEL cannot merge these: every session starts its own. %@ of it sits in sessions that are not working right now; Free memory suspends those. Running a server once and connecting sessions to it over HTTP removes the copies for good.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL не может их объединить: каждая сессия запускает свою копию. %@ из этого приходится на сессии, которые сейчас не работают; «Освободить память» приостанавливает их. Если запустить сервер один раз и подключать к нему сессии по HTTP, копии исчезнут насовсем."
          }
        }
      }
    },
    "PEPEL cannot tell what this program is for.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL не может определить, для чего эта программа."
          }
        }
      }
    },
    "PEPEL cannot tell when it was last started.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL не может определить, когда был последний запуск."
          }
        }
      }
    },
    "PEPEL cannot tell which application is in front.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL не может определить, какое приложение на переднем плане."
          }
        }
      }
    },
    "PEPEL cannot tell which application this session lives in, so it could not wake it when you come back.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL не может определить, в каком приложении работает эта сессия, поэтому не сможет разбудить её, когда вы вернётесь."
          }
        }
      }
    },
    "PEPEL cannot tell which application this session lives in; wake it yourself with `pepel thaw`.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL не может определить, в каком приложении работает эта сессия; разбудите её сами командой `pepel thaw`."
          }
        }
      }
    },
    "PEPEL could not establish which project this process belongs to.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL не удалось установить, к какому проекту относится этот процесс."
          }
        }
      }
    },
    "PEPEL could not open its database (%@). Running without history.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL не удалось открыть свою базу данных (%@). Работа без истории."
          }
        }
      }
    },
    "PEPEL did not need to do anything.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL ничего не понадобилось делать."
          }
        }
      }
    },
    "PEPEL does not know what this process is for; it only sees that nothing has touched it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL не знает, для чего этот процесс; видно лишь, что к нему никто не обращался."
          }
        }
      }
    },
    "PEPEL does not quit itself or the application it runs in.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL не закрывает себя и приложение, в котором работает."
          }
        }
      }
    },
    "PEPEL does not start at login.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL не запускается при входе в систему."
          }
        }
      }
    },
    "PEPEL does not suspend the session it is running in.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL не приостанавливает сессию, в которой работает."
          }
        }
      }
    },
    "PEPEL does not terminate itself or its own ancestors.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL не завершает себя и свои родительские процессы."
          }
        }
      }
    },
    "PEPEL found no abandoned developer processes to recover memory from; the largest consumers are listed for your judgement.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL не нашёл брошенных процессов разработки, за счёт которых можно освободить память; самые крупные потребители показаны, решать вам."
          }
        }
      }
    },
    "PEPEL has not observed this project long enough.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL наблюдает за этим проектом недостаточно долго."
          }
        }
      }
    },
    "PEPEL has not watched it long enough to say how busy it is.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL наблюдает слишком недолго, чтобы сказать, насколько он загружен."
          }
        }
      }
    },
    "PEPEL has only today's reading of what the containers use; a busier day may need more.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У PEPEL есть только сегодняшний замер того, сколько используют контейнеры; в более загруженный день может понадобиться больше."
          }
        }
      }
    },
    "PEPEL is in the way": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL мешает"
          }
        }
      }
    },
    "PEPEL is paused.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL приостановлен."
          }
        }
      }
    },
    "PEPEL is paused: no rule runs until it is resumed.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL приостановлен: правила не выполняются, пока его не возобновят."
          }
        }
      }
    },
    "PEPEL itself holds %@ while %@ runs.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "PEPEL itself holds %1$@ while %2$@ runs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сам PEPEL занимает %@, пока выполняется %@."
          }
        }
      }
    },
    "PEPEL itself holds %@.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сам PEPEL занимает %@."
          }
        }
      }
    },
    "PEPEL itself · %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сам PEPEL · %@"
          }
        }
      }
    },
    "PEPEL itself · %@ · %lld%% CPU": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "PEPEL itself · %1$@ · %2$lld%% CPU"
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Сам PEPEL · %@ · %lld%% CPU"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Сам PEPEL · %@ · %lld%% CPU"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Сам PEPEL · %@ · %lld%% CPU"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Сам PEPEL · %@ · %lld%% CPU"
                }
              }
            }
          }
        }
      }
    },
    "PEPEL may flush the file cache without asking for a password.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL может сбрасывать файловый кэш без запроса пароля."
          }
        }
      }
    },
    "PEPEL never removes named volumes: they hold data rebuilding does not bring back. Remove one yourself with docker volume rm.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL никогда не удаляет именованные тома: в них данные, которые пересборка не вернёт. Удалите такой том сами командой docker volume rm."
          }
        }
      }
    },
    "PEPEL runs with your normal user rights. It does not request Full Disk Access or Accessibility. Administrator rights are asked for once, only if you use the file cache flush.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL работает с обычными правами пользователя. Он не запрашивает полный доступ к диску и универсальный доступ. Права администратора запрашиваются один раз и только если вы используете сброс файлового кэша."
          }
        }
      }
    },
    "PEPEL samples memory and processes but scans storage only when you ask.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL регулярно замеряет память и процессы, а хранилище сканирует только по вашему запросу."
          }
        }
      }
    },
    "PEPEL saw it running as a child of %@.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL видел его запущенным как дочерний процесс %@."
          }
        }
      }
    },
    "PEPEL scans in the background and tells you what it finds. Nothing is removed without you.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL сканирует в фоне и сообщает, что нашёл. Без вас ничего не удаляется."
          }
        }
      }
    },
    "PEPEL sends SIGTERM, waits for the process to exit, and records memory pressure before and after. The memory a process holds is not guaranteed to become available.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL отправляет SIGTERM, ждёт завершения процесса и записывает нагрузку на память до и после. Память, которую занимал процесс, не обязательно станет доступной."
          }
        }
      }
    },
    "PEPEL starts when you log in.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL запускается при входе в систему."
          }
        }
      }
    },
    "PEPEL terminated %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL завершил %@"
          }
        }
      }
    },
    "PEPEL uses %lld%% CPU with no scan running.": {
      "localizations": {
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "PEPEL использует %lld%% CPU, хотя сканирование не идёт."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "PEPEL использует %lld%% CPU, хотя сканирование не идёт."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "PEPEL использует %lld%% CPU, хотя сканирование не идёт."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "PEPEL использует %lld%% CPU, хотя сканирование не идёт."
                }
              }
            }
          }
        }
      }
    },
    "PEPEL wants to flush the file cache, and to be allowed to do so without asking again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL хочет сбросить файловый кэш и получить разрешение делать это без повторного запроса."
          }
        }
      }
    },
    "PEPEL wants to remove its permission to flush the file cache without asking.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL хочет удалить своё разрешение сбрасывать файловый кэш без запроса."
          }
