          }
        },
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Занятая память росла примерно на %@ в час за последние %@. При таком темпе она достигнет %lld%% памяти этого Mac примерно через %@ — на этом уровне macOS обычно начинает испытывать трудности."
                }
              },
              "many": {
                "stringUnit": {
