    "%@ available. No reclaimable developer artifacts are known; run a scan to diagnose.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступно %@. Артефакты разработки, место которых можно освободить, неизвестны; запустите сканирование, чтобы разобраться."
          }
        }
      }
    },
    "%@ available. Up to %@ of developer artifacts can be reviewed for cleanup.": {
      "localizations": {
