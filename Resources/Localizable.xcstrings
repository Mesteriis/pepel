          }
        }
      }
    },
    "Dependency cache": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэш зависимостей"
          }
        }
      }
    },
    "Dependency sources fetched by SwiftPM. `swift package resolve` downloads them again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходники зависимостей, загруженные SwiftPM. `swift package resolve` скачает их снова."
          }
        }
      }
    },
    "DerivedData could not be read.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать DerivedData."
          }
        }
      }
    },
    "Detached servers are often left running on purpose, so this is not treated as garbage.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсоединённые серверы часто оставляют работать намеренно, поэтому это не считается мусором."
          }
        }
      }
    },
    "Developer artifacts found on this Mac. Sizes are blocks allocated on disk; where files are hard-linked, cloned or unreadable the figure is an upper bound, marked ≤.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Артефакты разработки, найденные на этом Mac. Размер — это блоки, занятые на диске; если файлы связаны жёсткими ссылками, клонированы или недоступны для чтения, значение — верхняя граница, помеченная ≤."
          }
        }
      }
    },
    "Developer processes": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Процессы разработки"
          }
        }
      }
    },
    "Developer processes (%lld of %lld)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Developer processes (%1$lld of %2$lld)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Процессы разработки (%lld из %lld)"
          }
        }
      }
    },
    "Developer processes not tied to a project or session.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Процессы разработки, не привязанные к проекту или сессии."
          }
        }
      }
    },
    "Developer tool": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инструмент разработчика"
          }
        }
      }
    },
    "Did not come back: %@.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вернулись: %@."
          }
        }
      }
    },
    "Different rules for one project:": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отдельные правила для проекта:"
          }
        }
      }
    },
    "Direct process, filesystem or metadata evidence.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прямые признаки из процессов, файловой системы или метаданных."
          }
        }
      }
    },
    "Directories containing CMakeCache.txt or build.ninja. Plain Make output has no reliable marker and is not detected.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папки с CMakeCache.txt или build.ninja. У результата обычного Make нет надёжного признака, поэтому он не обнаруживается."
          }
        }
      }
    },
    "Discovering projects": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск проектов"
          }
        }
      }
