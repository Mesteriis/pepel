    },
    "%@ is charged to it and %@ of that is in RAM; the rest is compressed or in swap.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is charged to it and %2$@ of that is in RAM; the rest is compressed or in swap."
