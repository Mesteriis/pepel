        }
      }
    },
    "None. PEPEL only proposes a process when its parent is gone and it has shown no CPU activity for %lld minutes of observation.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "None. PEPEL only proposes a process when its parent is gone and it has shown no CPU activity for %lld minute of observation."
