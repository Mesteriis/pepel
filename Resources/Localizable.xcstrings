    "%@\n\nAndroid Studio or sdkmanager downloads one again when a new emulator needs it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nAndroid Studio или sdkmanager скачает его снова, когда он понадобится новому эмулятору."
          }
        }
      }
    },
    "%@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@"
          }
        }
      }
    },
