    "Trashed items can be restored but free no space until the Trash is emptied. Permanent removal and tool cleanups cannot be undone.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправленное в Корзину можно вернуть, но место не освобождается, пока Корзина не очищена. Удаление навсегда и очистку инструментами отменить нельзя."
          }
        }
      }
    },
    "Treat artifacts written in the last %lld min as in use": {
      "localizations": {
