          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Остановлены контейнеры %lld проектов."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Остановлены контейнеры %lld проектов."
                }
              },
