        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сборки, память и процессы"
          }
        }
      }
    },
    "Builds, tests and servers running in this project outside an agent session.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сборки, тесты и серверы, работающие в этом проекте вне сессии агента."
          }
        }
      }
    },
    "Builds, tests and servers whose parent is gone and that have shown no activity.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сборки, тесты и серверы, чей родительский процесс завершился и которые не проявляют активности."
          }
        }
      }
    },
    "Built from %@, which no longer exists. Nothing can use these products any more.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собрано из %@, которого больше нет. Эти продукты больше никто не может использовать."
          }
        }
      }
    },
    "Bun install cache": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэш установки Bun"
          }
        }
      }
    },
    "Bundler output, ignored by git. Recreated by the project's build script.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вывод бандлера, игнорируется git. Создаётся заново скриптом сборки проекта."
          }
        }
      }
    },
    "Cache directory of the Claude Code CLI in ~/Library/Caches. macOS itself may purge this location.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каталог кэша CLI Claude Code в ~/Library/Caches. macOS может сама очищать это место."
          }
        }
      }
