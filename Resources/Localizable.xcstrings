        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остатки закрытых приложений и приложения, которые открыты, но не используются. Закрытие приложения — всегда обычный запрос, и PEPEL всегда сначала спрашивает вас."
          }
        }
      }
    },
