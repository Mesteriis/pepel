    "Install or update the note": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить или обновить заметку"
          }
        }
      }
    },
    "Installed dependencies": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установленные зависимости"
          }
        }
      }
    },
    "Installed npm packages. Restored by the package manager's install command.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установленные пакеты npm. Восстанавливаются командой установки менеджера пакетов."
          }
        }
      }
    },
    "Irreversible": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необратимо"
          }
        }
      }
    },
    "It belongs to another user.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принадлежит другому пользователю."
          }
        }
      }
    },
    "It carries the label pepel.keep.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имеет метку pepel.keep."
          }
        }
      }
    },
    "It could not be moved to the Trash.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отправить в Корзину."
          }
        }
      }
    },
    "It could not be moved.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось переместить."
          }
        }
      }
    },
    "It could not be removed: %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось удалить: %@"
          }
        }
      }
    },
    "It has a Finder tag.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Есть тег Finder."
          }
        }
      }
    },
    "It has used almost no CPU for %@, so it is not the tab in front and nothing is playing in it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почти не использует CPU уже %@: это не активная вкладка, и в ней ничего не воспроизводится."
          }
        }
      }
    },
    "It holds %@; a fresh copy starts small.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Занимает %@; новая копия начинает с малого объёма."
          }
        }
      }
    },
    "It holds %@; the budget is %@. PEPEL only reports this: restart, suspend or end it yourself.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "It holds %1$@; the budget is %2$@. PEPEL only reports this: restart, suspend or end it yourself."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Занимает %@ при бюджете %@. PEPEL только сообщает об этом: перезапустите, приостановите или завершите его сами."
          }
        }
      }
    },
    "It holds a socket or pipe: a program is, or was, connected through it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Содержит сокет или канал: через него подключена или была подключена программа."
          }
        }
      }
    },
    "It holds an active resource lease.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Есть действующая аренда ресурса."
          }
        }
      }
    },
    "It is a developer process; it is not terminated just because its application quit.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это процесс разработки; его не завершают только потому, что закрылось его приложение."
          }
        }
      }
    },
    "It is marked as not to be cleaned.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помечено как не подлежащее очистке."
          }
        }
      }
    },
    "It is not a folder any more.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это больше не папка."
          }
        }
      }
    },
    "It is not inside a known project.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не находится внутри известного проекта."
          }
        }
      }
    },
    "It is on PEPEL's keep list.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Входит в список исключений PEPEL."
          }
        }
      }
    },
    "It is on the keep list.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Входит в список исключений."
          }
        }
      }
    },
    "It is on the leave-alone list.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Входит в список «не трогать»."
          }
        }
      }
    },
    "It is running (its lock is held).": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работает (его блокировка удерживается)."
          }
        }
      }
    },
    "It is running.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работает."
          }
        }
      }
    },
    "It is still using CPU and may be doing real work.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё ещё использует CPU и, возможно, выполняет полезную работу."
          }
        }
      }
    },
    "It is the working directory of %@ (PID %d).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "It is the working directory of %1$@ (PID %2$d)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это рабочая папка %@ (PID %d)."
          }
        }
      }
    },
    "It listens on port %@; something may still connect to it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слушает порт %@; к нему ещё могут подключиться."
          }
        }
      }
    },
    "It no longer contains CMake or Ninja build files.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больше не содержит файлов сборки CMake или Ninja."
          }
        }
      }
    },
    "It no longer looks like a DerivedData build folder.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больше не похоже на папку сборки DerivedData."
          }
        }
      }
    },
    "It still holds a terminal or a listening port.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё ещё держит терминал или слушающий порт."
          }
        }
      }
    },
    "It was already put back.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже возвращено."
          }
        }
      }
    },
    "Its age could not be determined.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось определить возраст."
          }
        }
      }
    },
    "Its analyzer is no longer available.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его анализатор больше недоступен."
          }
        }
      }
    },
    "Its compose project is on PEPEL's keep list.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его compose-проект входит в список исключений PEPEL."
          }
        }
      }
    },
    "Its descendant %@ (PID %d) must not be terminated: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Its descendant %1$@ (PID %2$d) must not be terminated: %3$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его потомка %@ (PID %d) нельзя завершать: %@"
          }
        }
      }
    },
    "Its executable is inside %@.app.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его исполняемый файл находится внутри %@.app."
          }
        }
      }
    },
    "Its name suggests it holds data (a database, dumps, backups or configuration). %@. It can be taken back from the Trash; the space is freed when the Trash is emptied.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Судя по имени, здесь хранятся данные (база данных, дампы, резервные копии или конфигурация). %@. Можно вернуть из Корзины; место освободится после очистки Корзины."
          }
        }
      }
    },
    "Its parent process has exited; it now belongs to launchd.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его родительский процесс завершился; теперь он принадлежит launchd."
          }
        }
      }
    },
    "Its parent process is still running and may be waiting for it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его родительский процесс ещё работает и, возможно, ждёт его."
          }
        }
      }
    },
    "Its process tree is using CPU (%@ of a core).": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его дерево процессов использует CPU (%@ ядра)."
          }
        }
      }
    },
    "Its project has not been touched for %@; installing or building again recreates this.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его проект не изменялся %@; повторная установка или сборка воссоздаст это."
          }
        }
      }
    },
    "Its project is excluded by one of your protection rules.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его проект исключён одним из ваших правил защиты."
          }
        }
      }
    },
    "Its project is excluded from cleanup.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его проект исключён из очистки."
          }
        }
      }
    },
    "Its working directory no longer exists.": {
