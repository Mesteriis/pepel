    "Used": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовано"
          }
        }
      }
    },
    "Used %@ of a core over the %@ PEPEL has watched it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Used %1$@ of a core over the %2$@ PEPEL has watched it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовал %1$@ ядра за %2$@ наблюдения PEPEL."
          }
        }
      }
    },
    "Used according to the disk, but in no folder PEPEL may read: system data, other users, guarded folders, snapshots and swap.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Занято по данным диска, но не в папках, доступных PEPEL для чтения: системные данные, другие пользователи, защищённые папки, снимки и подкачка."
          }
        }
      }
    },
    "Used by containers": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется контейнерами"
          }
        }
      }
    },
    "Used within the last %lld days.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Used within the last %lld day."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Used within the last %lld days."
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Использовалось за последние %lld дня."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Использовалось за последние %lld дней."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Использовалось за последний %lld день."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Использовалось за последние %lld дней."
                }
              }
            }
          }
        }
