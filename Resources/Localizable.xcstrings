    "VM": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ВМ"
          }
        }
      }
    },
    "VM restarted: charged %@ before, %@ after.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "VM restarted: charged %1$@ before, %2$@ after."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ВМ перезапущена: было %1$@, стало %2$@."
          }
        }
      }
    },
    "Verified disposable, not in use.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверено: можно удалить, не используется."
          }
        }
      }
    },
    "Virtual devices in ~/.android/avd. Deleting one removes the apps and data inside it; the system images stay, so it can be created again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Виртуальные устройства в ~/.android/avd. Удаление устройства удаляет приложения и данные в нём; системные образы остаются, поэтому его можно создать заново."
          }
        }
      }
    },
    "Virtual environment": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Виртуальное окружение"
          }
        }
      }
    },
    "Virtual environments, node_modules and build output are removed. Opening a project again means installing its dependencies again. Anything in use, recently written, pinned or excluded stays.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Виртуальные окружения, node_modules и результаты сборки удаляются. Чтобы снова открыть проект, придётся заново установить зависимости. Всё используемое, недавно записанное, закреплённое или исключённое остаётся."
          }
        }
      }
    },
    "Virtual machine (owner not identified)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Виртуальная машина (владелец не определён)"
          }
        }
      }
    },
    "Virtual machine disks holding images, containers and volumes. Manage them with the tool that created them.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диски виртуальных машин с образами, контейнерами и томами. Управляйте ими через создавший их инструмент."
          }
        }
      }
    },
    "Virtual machine limit": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предел виртуальной машины"
          }
        }
      }
    },
    "Virtual machines and containers": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Виртуальные машины и контейнеры"
          }
        }
      }
    },
    "Volumes are never removed by PEPEL.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PEPEL никогда не удаляет тома."
          }
        }
      }
    },
    "Volumes hold data; they are only removed when you ask.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В томах хранятся данные; они удаляются только по запросу."
          }
        }
      }
    },
    "Wait %lld min after the application quit": {
      "localizations": {
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
